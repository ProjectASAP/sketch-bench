{
 "query_workload": {
  "language": "promql",
  "repeating_queries": [
   {
    "query": "sum by (job) (rate(requests_total[1h]))",
    "demand": {
     "fixed_interval_at": {
      "interval": 60000,
      "evaluation_phase": 0
     }
    },
    "requirements": {
     "accuracy": {
      "max_error": 0.01,
      "failure_probability": 0.01,
      "accuracy_scope": "per_value",
      "accuracy_metric": "relative"
     }
    },
    "predictability": {
     "predictable": {
      "known_at": null
     }
    }
   }
  ]
 },
 "data_workload": {
  "arrival": {
   "ingesting": {
    "rows_per_second": 1000.0
   }
  },
  "sources": {
   "requests_total": {
    "series_count": 1000,
    "metric_type": "counter",
    "sample_interval": 1000,
    "distinct_values_per_label": {
     "job": 10,
     "instance": 100
    }
   }
  }
 }
}
