{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MergedRecord",
  "description": "Flattened form of the [`Record`]s that share one (sketch, impl,\nsketch_config, workload) identity: one row per cell, where the record\nstream writes one per square. Built by `aqpbm-cli`'s `flatten_record`.\nLives beside [`Record`] because it is a JSONL wire shape, not CLI logic.",
  "type": "object",
  "properties": {
    "heap_bytes_net": {
      "description": "Net bytes the tracking allocator attributes to this sketch's\nlifetime — **measured**, where [`Self::memory_bytes`] is a\nself-reported formula. Only present when the source binary was built\nwith `heap-track`; kept as its own field (not merged into\n`memory_bytes`) so a gap between the two stays visible instead of\nbeing silently papered over.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "heap_bytes_peak": {
      "description": "High-water mark of the same counter across construction and insert.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "impl": {
      "type": "string"
    },
    "insert_build_throughput_items_per_sec": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "insert_cpu_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/CpuTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "insert_heap_allocated_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "insert_latency_ns": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatencySummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "insert_rss_peak_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "insert_throughput_items_per_sec": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "insert_throughput_samples": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number",
        "format": "double"
      }
    },
    "insert_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "insert_wall_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "$ref": "#/$defs/Language"
    },
    "memory_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "merge_cpu_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/CpuTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_folds_per_sec": {
      "description": "How many folds a second: the throughput reading of the same clock.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_heap_allocated_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "merge_rss_peak_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "merge_shards": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint",
      "minimum": 0
    },
    "merge_supported": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "merge_time_ms": {
      "description": "How long one fold took: the latency reading of this operation.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "merge_wall_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "prepare_cpu_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/CpuTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare_finalize_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "prepare_heap_allocated_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "prepare_rss_peak_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "prepare_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "prepare_wall_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_accuracy": {
      "description": "The comparator's scores. Only this operation has them: accuracy is\nwhat an answer can be scored for, and query is what produces one."
    },
    "query_cpu_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/CpuTime"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_heap_allocated_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "query_latency_ns": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatencySummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_rss_peak_kb": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "query_throughput_items_per_sec": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "query_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "query_wall_time_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ]
    },
    "runs": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "sketch": {
      "type": "string"
    },
    "sketch_config": true,
    "source": {
      "$ref": "#/$defs/Source"
    },
    "workload": {
      "$ref": "#/$defs/WorkloadDescription"
    }
  },
  "required": [
    "heap_bytes_net",
    "heap_bytes_peak",
    "impl",
    "insert_build_throughput_items_per_sec",
    "insert_cpu_time_ms",
    "insert_heap_allocated_kb",
    "insert_latency_ns",
    "insert_rss_peak_kb",
    "insert_throughput_items_per_sec",
    "insert_throughput_samples",
    "insert_timestamp",
    "insert_wall_time_ms",
    "language",
    "memory_bytes",
    "merge_cpu_time_ms",
    "merge_heap_allocated_kb",
    "merge_rss_peak_kb",
    "merge_shards",
    "merge_supported",
    "merge_time_ms",
    "merge_timestamp",
    "merge_wall_time_ms",
    "mode",
    "prepare_cpu_time_ms",
    "prepare_finalize_time_ms",
    "prepare_heap_allocated_kb",
    "prepare_rss_peak_kb",
    "prepare_timestamp",
    "prepare_wall_time_ms",
    "query_accuracy",
    "query_cpu_time_ms",
    "query_heap_allocated_kb",
    "query_latency_ns",
    "query_rss_peak_kb",
    "query_throughput_items_per_sec",
    "query_timestamp",
    "query_wall_time_ms",
    "runs",
    "schema_version",
    "sketch",
    "sketch_config",
    "source",
    "workload"
  ],
  "x-schema-version": 3,
  "$defs": {
    "CpuTime": {
      "description": "CPU time split into user vs sys.",
      "type": "object",
      "properties": {
        "sys_ms": {
          "$ref": "#/$defs/RunStats"
        },
        "user_ms": {
          "$ref": "#/$defs/RunStats"
        }
      },
      "required": [
        "user_ms",
        "sys_ms"
      ]
    },
    "Language": {
      "description": "Implementation language of the run that produced this record.\nUsed by readers to split apples-to-apples comparisons.",
      "type": "string",
      "enum": [
        "rust",
        "cpp"
      ]
    },
    "LatencySummary": {
      "description": "Latency percentile summary extracted from an\n`hdrhistogram::Histogram`.",
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p50": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p99": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "p999": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "p50",
        "p95",
        "p99",
        "p999",
        "max",
        "count"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "bench",
        "profile",
        "runtime"
      ]
    },
    "RunStats": {
      "description": "Aggregate across N samples: mean / stddev / optional 95% CI.",
      "type": "object",
      "properties": {
        "ci95": {
          "description": "95% CI on the mean — **present only when the samples are statistically\nindependent**, i.e. `--repeats R` (R > 1) over R processes. Iterations of\none `--runs N` share too much for an interval over them to mean anything.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "mean": {
          "type": "number",
          "format": "double"
        },
        "n": {
          "description": "Number of samples behind `mean`. Iterations within one process when\n`ci95` is absent; independent processes when it is present.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "stddev": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "mean",
        "stddev",
        "n"
      ]
    },
    "Source": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "data-collector",
            "asap-query"
          ]
        },
        {
          "description": "Run produced by the `approxbench` CLI.",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "Run produced by an embedded `sketch-runtime::Sampler`\nin one of the downstream apps.",
          "type": "string",
          "const": "asap-fusion"
        },
        {
          "description": "Run produced by a `cpp-bench` binary (Google Benchmark\nbased C++ track). See `docs/SCHEMA_V1.md`.",
          "type": "string",
          "const": "cpp-bench"
        }
      ]
    },
    "WorkloadDescription": {
      "description": "Human-friendly description of a workload — serialised into\nevery report so a JSONL record can be re-run without\nexternal metadata.",
      "type": "object",
      "properties": {
        "cardinality": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "shape": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "description": "Full `datagen` description, when the flat fields above cannot express it\n(several columns, a shift, a special rule, string options, …). Absent for\na plain single `uniform` / `zipf` column and for `file`, whose flat\nfields already round-trip."
        },
        "zipf_s": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "shape",
        "size"
      ]
    }
  }
}
